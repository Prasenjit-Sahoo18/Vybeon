# Environment Variables — VYBEON
# Copy this file to .env.local for local development
# NEVER commit .env.local to version control

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/vybeon
# Render: Automatically injected from the render.yaml blueprint
DATABASE_URL=

# ─── NextAuth / Auth.js ─────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=

# Full URL of the app (no trailing slash)
# Local:   http://localhost:3000
# Render:  https://your-app-name.onrender.com
NEXTAUTH_URL=

# ─── App Config ─────────────────────────────────────────────────────────────
NODE_ENV=production

# Set to "true" to use seeded demo catalog (no external music API needed)
DEMO_MODE=true

# ─── Optional: External Music API ───────────────────────────────────────────
# Leave empty when DEMO_MODE=true
# Supported providers: jamendo, freemusicarchive (future)
MUSIC_API_URL=
MUSIC_API_KEY=

# ─── Optional: GitHub OAuth ─────────────────────────────────────────────────
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
